# =============================================================================
# Meeting Summarizer - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env
#
# Then load before running:
#   # PowerShell
#   Get-Content .env | ForEach-Object { if ($_ -and $_ -notmatch '^\s*#') { $k,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($k.Trim(), $v.Trim()) } }
#
#   # Bash
#   export $(grep -v '^#' .env | xargs)
# =============================================================================

# --- Option 1: Any OpenAI-compatible provider (NVIDIA, OpenAI, Ollama, etc.) ---
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=google/gemma-4-31b-it

# --- Option 2: Anthropic (Claude) ---
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Whisper transcription (needed for audio files only) ---
# OPENAI_API_KEY=your-openai-api-key-here
